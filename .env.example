# =====================================================================
# Crypto Trading Bot - Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit .env.
# =====================================================================

# ---- Application ----
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- Mode ----
# paper  -> simulated trading, no on-chain transactions
# live   -> real trades on BSC. ONLY enable after extensive testing.
TRADING_MODE=paper

# ---- BSC RPC ----
# Get from: https://docs.bnbchain.org/docs/rpc/ or use a paid provider
BSC_RPC_URL=https://bsc-dataseed1.binance.org
BSC_RPC_FALLBACK=https://bsc-dataseed2.binance.org
BSC_CHAIN_ID=56

# Testnet (recommended for first deployment)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_TESTNET_CHAIN_ID=97

# ---- Wallet ----
# Encrypted at rest. The plain key is decrypted only in memory.
# Generate via: python backend/scripts/encrypt_key.py
WALLET_ENCRYPTED_KEY=
WALLET_ENCRYPTION_PASSWORD=
WALLET_ADDRESS=

# ---- PancakeSwap (V2 mainnet defaults) ----
PANCAKESWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
PANCAKESWAP_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
BUSD_ADDRESS=0xe9e7CEA3DedcA5984780Bafc599bD69ADd087D56
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# ---- Trading defaults ----
DEFAULT_QUOTE_TOKEN=WBNB           # base token to pair against
TRADE_TOKEN_LIST=                   # comma-separated BEP20 addresses to trade
BLACKLIST_TOKENS=                   # comma-separated tokens to never trade

# ---- Risk limits ----
MAX_CAPITAL_PER_TRADE_USD=200
MIN_CAPITAL_THRESHOLD_USD=10
MAX_TRADES_PER_HOUR=6
MAX_SLIPPAGE_PCT=1.0                # 1.0 = 1%
MAX_DAILY_LOSS_PCT=5.0
CIRCUIT_BREAKER_LOSSES=3            # halt after N consecutive losses
MAX_GAS_PRICE_GWEI=10               # skip if gas above this
MIN_LIQUIDITY_USD=50000             # require pool liquidity

# ---- Fees ----
FEE_BUFFER_PCT=0.5                  # min profit margin above costs
PANCAKE_LP_FEE_PCT=0.25             # PancakeSwap V2 LP fee

# ---- Exit / position management (fallback fixed-% — smart_trend uses ATR R-multiples) ----
TAKE_PROFIT_PCT=2.0                 # close long at +2%
STOP_LOSS_PCT=1.5                   # close long at -1.5%
TRAILING_STOP_PCT=1.0               # drawdown from peak to trigger close
MAX_HOLDING_MINUTES=240              # auto-close after this many minutes (0 disables)
MIN_SIGNAL_CONFIDENCE=0.60          # ignore signals below this confidence
MIN_SECONDS_BETWEEN_TRADES=600      # per-token cooldown between trades (10 min)
MAX_OPEN_POSITIONS=3                # cap concurrent open positions
STARTING_PAPER_CAPITAL_USD=1000     # paper-mode starting wallet

# ---- Smart sizing & multi-window ----
RISK_PER_TRADE_PCT=1.0              # % of equity at risk per trade (Kelly-lite)
MAX_CONCENTRATION_PCT=30.0          # no single position > 30% of cash
PAPER_MODE_SLIPPAGE_PCT=0.3         # realistic slippage on major BSC pairs
MAX_CONCURRENT_WINDOWS=3            # max simultaneous trading windows

# ---- AI ----
AI_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.6
LSTM_MODEL_PATH=backend/data/models/lstm.pkl
RF_MODEL_PATH=backend/data/models/rf.pkl

# ---- Alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- Database ----
DATABASE_URL=sqlite:///./backend/data/bot.db

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ---- API rate limiting ----
RATE_LIMIT_PER_MINUTE=60
